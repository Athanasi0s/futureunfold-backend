# Ρυθμίσεις βάσης δεδομένων
DATABASE_URL=postgresql+psycopg2://panathenea:panathenea@localhost:5442/panathenea

# Μυστικό κλειδί για tokens (σε production πρέπει να είναι ΜΕΓΑΛΟ και κρυφό)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@example.com
EVENT_NAME=Panathenea Festival
ADMIN_EMAILS=sarmatas83@gmail.com

# EVENTORA signed invitation JWTs. Request the production value through a
# secure channel; do not put a real secret in source control or email.
EVENTORA_MAGIC_LINK_SECRET=replace_with_secure_shared_secret
EVENTORA_MAGIC_LINK_ISSUER=eventora
EVENTORA_MAGIC_LINK_AUDIENCE=future-unfold-app

# Multi-tenancy: which tenant this deployment serves. REQUIRED — app refuses to boot without it.
# Local dev: use "panathenea". Production: set per-tenant via `fly secrets set TENANT_KEY=<slug>`.
TENANT_KEY=panathenea

# Local API URL and writable upload directory.
PUBLIC_BASE_URL=http://localhost:8000
UPLOAD_DIR=./data/uploads
